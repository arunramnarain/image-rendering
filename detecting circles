import cv2 
import numpy as np

img = cv2.imread("images\\cat_visible_eyes.jpg", cv2.IMREAD_COLOR)
cv2.imshow("cat", img)
cv2.waitKey(0)

# convert BGR to greyscale

grey = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
cv2.imshow("grayscale cat", grey)
cv2.waitKey(0)

# blur
grey_blur = cv2.GaussianBlur(grey, (5,5), 7)
cv2.imshow("gaussian blur",grey_blur)
cv2.waitKey(0)

# detecting circles

detect_circle = cv2.HoughCircles(grey_blur, cv2.HOUGH_GRADIENT,
                                  dp = 1, minDist = 20, param1 = 50,
                                  param2 = 30, minRadius=1, 
                                  maxRadius= 30)

if detect_circle is not None:
    detect_circle = np.uint16(np.around(detect_circle))
    for point in detect_circle[0,:]:
        x,y,r = point[0], point[1], point[2]
        cv2.circle(img, (x,y),r, (0,0,234), 2)

        cv2.imshow("detect_circle", img)
        cv2.waitKey(0)

cv2.destroyAllWindows()
#dp resolution is to keep the resolution the same
