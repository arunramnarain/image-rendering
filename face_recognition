import cv2, sys, numpy, os

haar_file = "haar_face.xml"
data_sets = "dataset"
sub_data = "Arun_pic"

path = os.path.join(data_sets, sub_data)
if not os.path.isdir(path):
    os.mkdir(path)

# define the size of the image
(width, height) = (130, 100)
face_cascade = cv2.CascadeClassifier(haar_file)
webcam = cv2.VideoCapture(0)
print("Capturing images. press 'q' to exit")
count = 0
while count < 10:# 10 images of the face
    _, frame = webcam.read()
    grey_img = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    faces = face_cascade.detectMultiScale(grey_img, 1.3, 5)
    # 1.3 in previous line is scale factor: specifies how much the image size 
    # is reduced at each image scale
    # 5 is minNieghbours: specifies the quality of faces detected

    for (x,y,w,h) in faces:
        cv2.rectangle(frame, (x,y), (x+w, h+y), (255, 0, 0), 2)

        # extract and resize the face
        face = grey_img[y:y+h, x:x +w]
        face_resize = cv2.resize(grey_img, (width, height))
        # save face image
        cv2.imwrite(f"{path}/{count}.png", face_resize)
        print(f"[INFO] Saved face {count}")
        count += 1
        # to capture the images of faces then close the window
        if count > 10:
            break

    cv2.imshow("Face Capture", frame)
    if cv2.waitKey(10) == ord("q"):
        break

print("capture completed")
webcam.release()
cv2.destroyAllWindows()

