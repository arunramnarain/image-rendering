import cv2, os
from PIL import Image
path = r"C:\\Users\\arun\\OneDrive\\Desktop\\Open_CV\\image_to_video_f"
os.chdir(path)

mean_h = 0
mean_w = 0
num_of_imgs = len(os.listdir("."))

for file in os.listdir("."):
    image = Image.open(os.path.join(path, file))
